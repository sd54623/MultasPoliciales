rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = existe el documento admins/<UID>. Solo se crea a mano desde la consola de Firebase.
    function esAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Suscripción activa = users/<UID>.expiraEn es una fecha futura (hora del servidor).
    function activo() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return 'expiraEn' in u && u.expiraEn is timestamp && u.expiraEn > request.time;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || esAdmin());
      // Cualquiera puede crear SU cuenta, pero sin acceso (no puede ponerse expiraEn).
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'nombre', 'creado']);
      // Solo el admin da o quita tiempo.
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }

    match /datos/{doc} {
      allow read: if request.auth != null && (esAdmin() || activo());
      allow write: if esAdmin();
    }
  }
}
